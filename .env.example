# Optional: add an Alchemy key for richer transfer categories.
# Without it, ChainTrace uses the free Blockscout fallback for investigations.
ALCHEMY_API_KEY=PASTE_YOUR_KEY_HERE
ALCHEMY_NETWORK=eth-mainnet
PORT=3000

# Optional email alerts. Popup alerts work even when email is not configured.
# Gmail: use an App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=ChainTrace <your-email@gmail.com>
ALERT_EMAIL_TO=your-email@gmail.com
